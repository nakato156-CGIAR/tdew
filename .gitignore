__pycache__/
*.py[oc]
*.pyd
*.so
*.dylib
*.dll
*$py.class
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log

# Packaging / build
build/
dist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.conda/
*.conda

# Agents
.claude
.codex
.agents

# Wiki: command/prompt definitions are content, not local agent settings
!/Wiki/.claude/
!/Wiki/.claude/**
!/Wiki/.codex/
!/Wiki/.codex/**

# Jupyter / notebooks
.ipynb_checkpoints/
.notebook/

# Quarto render cache
.quarto/

# IDE / editor
.vscode/
.idea/
*.iml

# OS junk
.DS_Store
.DS_Store?
Thumbs.db

# Secrets / local config
.env
.env.*
*.pem
*.key

# Large data + outputs (project-specific)
results/
output/
outputs/
data/
datasets/
*.parquet
*.feather
*.arrow
*.zarr
*.nc
*.h5
*.hdf5
*.tif
*.tiff

# NOTE: the "data/" rule above also matches "Data/" case-insensitively on
# Windows checkouts, which silently hid the whole Data/ medallion tree (the
# project's real data dir) from git, including any DVC ".dvc" pointer files.
# Targeted un-ignore so DVC pointer files can be tracked while the actual
# (large) data content stays out of git. Extend this chain if more paths
# under Data/ need their .dvc pointers tracked.
!/Data/
/Data/*
!/Data/silver/
/Data/silver/*
!/Data/silver/department_grid_ids.dvc

# Dask artifacts
dask-worker-space/
presentations/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
