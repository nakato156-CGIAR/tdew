{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-hooks/bead_sync.py\"",
            "timeout": 90,
            "statusMessage": "Sincronizando bead cerrado con el GitHub Project"
          }
        ]
      }
    ]
  }
}
