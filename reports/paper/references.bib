% --- added 2026-09-07: nonparametric smoothing at jumps ---
%
% Five southern-Amazonian dry-to-wet transition references (wright2017, li2004, fu2004,
% yin2014, marengo2017) were removed on 2026-09-16. They supported an attribution of the
% November extremes to that transition, which the data did not sustain: the affected area is
% equatorial rather than southern Amazonian, no precipitation product covers it, and the
% November feature is a one-month spike in the source product present at every support tier.
% The retrieval records remain under .asta/ if the attribution is ever revisited.






@article{zhang2016,
  title   = {Testing for jumps in the presence of smooth changes in trends of nonstationary time series},
  author  = {Zhang, Ting},
  journal = {Electronic Journal of Statistics},
  volume  = {10},
  year    = {2016},
  doi     = {10.1214/16-EJS1127},
  note    = {Nonparametric trend smoothing requires the underlying function to be smooth; jumps must be detected and estimated separately}
}

